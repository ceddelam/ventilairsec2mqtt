{
  "name": "ventilairsec2mqtt",
  "version": "0.1.0",
  "private": true,
  "description": "Bridge between Ventilairsec ventilation units (EnOcean MSC D1-079) and MQTT",
  "license": "MIT",
  "homepage": "https://github.com/ceddelam/ventilairsec2mqtt",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ventilairsec2mqtt": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bridge": {
      "types": "./dist/bridge/index.d.ts",
      "default": "./dist/bridge/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --test 'test/**/*.test.ts'",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:integration": "node --test --test-concurrency=1 'test/integration/*.e2e.ts'",
    "test:compiled": "node scripts/test-compiled.mjs",
    "test:node20": "node scripts/test-node20.mjs",
    "test:app": "node --test --test-concurrency=1 'test/packaging/*.e2e.ts'",
    "test:standalone": "node scripts/test-standalone.mjs",
    "start": "node dist/main.js",
    "app:local": "node scripts/app-local.mjs",
    "pack": "node scripts/pack.mjs",
    "changelog:sync": "node scripts/changelog.mjs",
    "icons": "node scripts/render-icons.mjs"
  },
  "dependencies": {
    "mqtt": "^5.16.1",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@serialport/binding-mock": "^10.2.2",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
