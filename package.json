{
  "name": "ventilairsec2mqtt",
  "version": "0.0.0",
  "private": true,
  "description": "Bridge between Ventilairsec ventilation units (EnOcean MSC D1-079) and MQTT",
  "license": "MIT",
  "homepage": "https://github.com/ceddelam/ventilairsec2mqtt",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ventilairsec2mqtt": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bridge": {
      "types": "./dist/bridge/index.d.ts",
      "default": "./dist/bridge/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --test 'test/**/*.test.ts'",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:integration": "node --test --test-concurrency=1 'test/integration/*.e2e.ts'",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "mqtt": "^5.16.1",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@serialport/binding-mock": "^10.2.2",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
